# MATLAB autosaves, backups, and generated code
*.asv
*.m~
*.autosave
*.mex*
*.p
slprj/
codegen/
MathWorks/

# MATLAB datasets and generated figures
*.mat
*.fig

# Generated workflow/validation outputs remain local.
tests/data/workflow-results/
tests/data/imagestackio-validation/
# Also exclude outputs created by older checkouts using the previous paths.
test-data/workflow-results/
test-data/imagestackio-validation/

# Microscopy acquisition and image data (keep local data out of source control)
*.tif
*.tiff
*.nd2
*.h5
*.hdf5
*.czi
*.lif
*.ims
*.oir
*.vsi
*.avi
*.mp4

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp

# Python bridge test caches
__pycache__/
*.py[cod]

# Local external installations are not redistributed with FARM.
local-dependencies/
